# Keep this file outside the public web root whenever possible.
URLTIME_API_KEY=replace-with-your-urltime-api-key
# Optional: comma/newline-separated OpenAI-compatible relay base URLs.
# A URL ending in /v1 is accepted; otherwise /v1/chat/completions is appended.
URLTIME_BASE_URLS=https://api.urltime.cn
# Optional: comma/newline-separated model IDs.
URLTIME_MODELS=deepseek-v4.1-flash
# Optional: seconds per upstream route and for the complete failover request.
AI_ROUTE_TIMEOUT=12
AI_TOTAL_TIMEOUT=60
# Set to 1 behind 1Panel/OpenResty so experiment records are isolated by the real client IP.
TRUST_PROXY=1
